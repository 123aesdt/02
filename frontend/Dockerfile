FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . ./
ARG VITE_DATA_MODE=api
ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_AUTHENTICATION_MODE=development_jwt
ARG VITE_RUNTIME_THREAD_STATE_ENABLED=false
ARG VITE_AMAP_KEY=
ARG VITE_AMAP_SECURITY_CODE=
ENV VITE_DATA_MODE=$VITE_DATA_MODE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AUTHENTICATION_MODE=$VITE_AUTHENTICATION_MODE
ENV VITE_RUNTIME_THREAD_STATE_ENABLED=$VITE_RUNTIME_THREAD_STATE_ENABLED
ENV VITE_AMAP_KEY=$VITE_AMAP_KEY
ENV VITE_AMAP_SECURITY_CODE=$VITE_AMAP_SECURITY_CODE
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

APP_ENV=development
APP_NAME=CountyFlow AI
RUNTIME_PROFILE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=sqlite+pysqlite:///countyflow.db
DATABASE_BACKEND=sqlite
REDIS_URL=redis://localhost:6379/0
REDIS_BACKEND=server
RUNTIME_CHECKPOINT_BACKEND=redis
RUNTIME_CHECKPOINT_NAMESPACE=countyflow
RUNTIME_CHECKPOINT_RETENTION_MINUTES=10080
RUNTIME_CHECKPOINT_REFRESH_ON_READ=false
RUNTIME_CHECKPOINT_MAX_BYTES=1048576
RUNTIME_CHECKPOINT_RECONCILIATION_SCAN_LIMIT=10
REDIS_STREAM_NAME=countyflow:dispatch:tasks
REDIS_CONSUMER_GROUP=countyflow-workers
REDIS_CONSUMER_NAME=worker-1
WORKER_CONSUMER_NAME=worker-1
WORKER_READ_COUNT=1
WORKER_BLOCK_MS=1000
WORKER_PENDING_MIN_IDLE_MS=5000
WORKER_RECOVERY_COUNT=10
WORKER_MAX_DELIVERY_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=30000
WORKER_IDEMPOTENCY_LOCK_TTL_MS=30000
REDIS_DLQ_STREAM_NAME=countyflow:dispatch:dlq
QDRANT_URL=http://localhost:6333
QDRANT_BACKEND=server
GRAPH_MEMORY_BACKEND=disabled
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=1.0
GRAPH_MEMORY_MAX_HOPS=2
GRAPH_MEMORY_RESULT_LIMIT=25
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
ENVIRONMENT_PROVIDER=development
CAPACITY_PROVIDER=in-memory
ROUTING_PROVIDER=in-memory
ENVIRONMENT_API_BASE_URL=
ENVIRONMENT_API_TIMEOUT_SECONDS=0.8
ENVIRONMENT_CB_FAILURE_THRESHOLD=3
ENVIRONMENT_CB_RECOVERY_SECONDS=5
CAPACITY_LIMITED_THRESHOLD=0.8
CAPACITY_UNAVAILABLE_THRESHOLD=1.0
MEMORY_ADOPTION_THRESHOLD=0.75
MEMORY_AUTO_APPLY_MIN_CONFIDENCE=0.75
MEMORY_LOWER_CONFIDENCE_REJECT_DELTA=0.15
MEMORY_MUTATION_TIMEOUT_SECONDS=5.0
MEMORY_MUTATION_LOCK_TTL_MS=10000
MEMORY_MUTATION_API_ENABLED=false
MEMORY_MUTATION_AUTHORIZATION_PROVIDER=disabled
VITE_RUNTIME_THREAD_STATE_ENABLED=false
RUNTIME_THREAD_API_ENABLED=false
RUNTIME_THREAD_AUTHORIZATION_PROVIDER=disabled
RUNTIME_THREAD_HISTORY_LIMIT=20
RUNTIME_THREAD_HISTORY_MAX_LIMIT=100
RUNTIME_OVERRIDE_API_ENABLED=false
RUNTIME_OVERRIDE_TIMEOUT_SECONDS=5.0
RUNTIME_OVERRIDE_LOCK_TTL_MS=8000
METRICS_ENABLED=false
METRICS_HOST=0.0.0.0
METRICS_PORT=9100
OBSERVABILITY_API_ENABLED=false
OBSERVABILITY_AUTHORIZATION_PROVIDER=disabled
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_PUBLIC_URL=
OBSERVABILITY_SAMPLE_INTERVAL_SECONDS=15
OBSERVABILITY_PROBE_TIMEOUT_SECONDS=0.8
RUNTIME_PROFILE=local
AUTHENTICATION_PROVIDER=disabled
AUTH_ISSUER=countyflow-dev
AUTH_AUDIENCE=countyflow-api
AUTH_JWKS_URL=
AUTH_ALGORITHMS=RS256,ES256
DEVELOPMENT_JWT_SECRET=
